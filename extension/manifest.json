{
  "manifest_version": 3,
  "name": "Trading Journal Sync",
  "version": "1.3",
  "description": "Sync TradingView charts directly to your Journal",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://tradingview.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.pages.dev/*",
    "https://trading-journal-3di.pages.dev/*",
    "https://trading.hibacsi.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/chart/*",
        "https://tradingview.com/chart/*"
      ],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tradingview.com/chart/*",
        "https://tradingview.com/chart/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.pages.dev/*",
        "https://trading-journal-3di.pages.dev/*",
        "https://trading.hibacsi.com/*"
      ],
      "js": ["journal-content.js"],
      "run_at": "document_start"
    }
  ]
}
